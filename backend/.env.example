# ---------------------------------------------------------------------------
# Copy to .env and edit, or export these directly. Every value has a working
# default, so the service starts with no configuration at all.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
CVXAI_HOST=127.0.0.1
CVXAI_PORT=8000
CVXAI_LOG_LEVEL=INFO
CVXAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- inference -------------------------------------------------------------
# auto | cuda | cpu
CVXAI_DEVICE=auto
# Load every component at startup instead of on first request. Costs about two
# minutes and several GB of RAM; worth it before a live demonstration.
CVXAI_EAGER_LOAD=0
CVXAI_MAX_UPLOAD_MB=64

# --- component roots -------------------------------------------------------
# Discovered automatically from the repository layout. Set these only if a
# component lives somewhere else.
# CVXAI_CXR_ROOT=../Component_01/Component_01
# CVXAI_ECG_ROOT=../Component_02/Component_02 (1)
# CVXAI_ECHO_ROOT=../Component_03/Dilukshan
# CVXAI_TRIAGE_ROOT=../Component_04/Component_04

# --- Component 02 ----------------------------------------------------------
# Must match the model the calibrator and conformal thresholds were fitted on,
# or the statistical guarantee does not hold. The service refuses to start the
# component on a mismatch.
CVXAI_ECG_MODEL=resnet_se
CVXAI_ECG_FILTER=1

# --- Component 03 ----------------------------------------------------------
# Ensemble members, and which run's validation-frozen decision rule is applied
# to their average.
CVXAI_ECHO_RUNS=uefnet_v3,uefnet_v3b,uefnet_v3c
CVXAI_ECHO_DECISION_RUN=uefnet_v3
CVXAI_ECHO_TTA_CLIPS=10

# --- Component 04 ----------------------------------------------------------
# Disclosure horizon in hours after ED arrival: 0, 6 or 24.
CVXAI_TRIAGE_HORIZON=24
# max-coverage (85 % coverage) or max-macro-F1 (65 % coverage).
CVXAI_TRIAGE_OPERATING_POINT=max-coverage
